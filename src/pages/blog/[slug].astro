---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../app/layouts/BaseLayout.astro';

export async function getStaticPaths() {
	return (await getCollection('blog')).map((post) => ({
		params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
	title={`${post.data.title} | Image Resizer`}
	description={post.data.description}>
	<article class='blog-post'>
		<header class='post-hero'>
			<a
				class='back-link'
				href='/blog/'
				>← All guides</a
			>
			<h1>{post.data.title}</h1>
			<p class='byline'>
				By {post.data.author} · {post.data.pubDate.toLocaleDateString('en', { dateStyle: 'long' })}
			</p>
		</header>
		<div class='post-body'>
			<Content />
		</div>
	</article>
</BaseLayout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.post-body pre').forEach((pre) => {
			if (pre.parentElement?.classList.contains('code-frame')) return;

			const frame = document.createElement('div');
			frame.className = 'code-frame';

			const button = document.createElement('button');
			button.className = 'copy-code';
			button.type = 'button';
			button.textContent = 'Copy';

			pre.parentNode.insertBefore(frame, pre);
			frame.append(button, pre);

			button.addEventListener('click', async () => {
				const code = pre.querySelector('code')?.textContent || pre.textContent || '';
				try {
					await navigator.clipboard.writeText(code);
					button.textContent = 'Copied';
				} catch {
					button.textContent = 'Failed';
				}
				window.setTimeout(() => {
					button.textContent = 'Copy';
				}, 1400);
			});
		});
	});
</script>

<style>
	.blog-post {
		width: 100%;
		margin: clamp(1rem, 7vw, 3rem) auto clamp(2rem, 8vw, 4rem);
	}

	.post-hero {
		margin-bottom: clamp(2.6rem, 6vw, 4.5rem);
	}

	.back-link {
		display: inline-flex;
		margin-bottom: 1.6rem;
		color: var(--ink-soft);
		font-weight: 750;
		text-underline-offset: 4px;
		transition:
			color 0.18s ease,
			transform 0.18s ease;
	}

	.back-link:hover {
		color: var(--blue);
		transform: translateX(-2px);
	}

	.post-hero h1 {
		max-width: 1080px;
		margin: 0;
		font-size: clamp(2.55rem, 6.1vw, 5.15rem);
		line-height: 0.98;
		letter-spacing: -0.065em;
		text-wrap: balance;
	}

	.byline {
		margin-top: 1.45rem;
		color: var(--ink-soft);
		font-size: 1rem;
	}

	.post-body {
		width: 100%;
		margin: 0;
		padding: clamp(1.3rem, 3vw, 2.25rem);
		border: 1px solid rgba(223, 228, 235, 0.8);
		border-radius: var(--radius-lg);
		background: rgba(255, 255, 255, 0.66);
		box-shadow: var(--shadow-sm);
		backdrop-filter: blur(10px);
	}

	.post-body :global(> *) {
		max-width: 860px;
	}

	.post-body :global(> .code-frame),
	.post-body :global(> pre),
	.post-body :global(> table),
	.post-body :global(> img),
	.post-body :global(> blockquote) {
		max-width: 100%;
	}

	.post-body :global(h2) {
		margin: 2.7rem 0 0.8rem;
		color: var(--ink);
		font-size: clamp(1.65rem, 3vw, 2.35rem);
		line-height: 1.12;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.post-body :global(h2:first-child) {
		margin-top: 0;
	}

	.post-body :global(h3) {
		margin: 2rem 0 0.55rem;
		color: var(--ink);
		font-size: 1.28rem;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}

	.post-body :global(p),
	.post-body :global(li) {
		color: var(--ink-soft);
		font-size: clamp(1rem, 1.4vw, 1.08rem);
		line-height: 1.78;
	}

	.post-body :global(p + p),
	.post-body :global(ul + p),
	.post-body :global(ol + p),
	.post-body :global(.code-frame + p),
	.post-body :global(pre + p) {
		margin-top: 1.15rem;
	}

	.post-body :global(ul),
	.post-body :global(ol) {
		display: grid;
		gap: 0.55rem;
		margin: 1rem 0 1.35rem;
		padding-left: 1.35rem;
	}

	.post-body :global(a) {
		color: var(--blue);
		font-weight: 750;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.post-body :global(blockquote) {
		margin: 1.8rem 0;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--blue);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		background: var(--blue-pale);
	}

	.post-body :global(img) {
		max-width: 100%;
		height: auto;
		margin: 1.8rem 0;
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
	}

	.post-body :global(:not(pre) > code) {
		padding: 0.13rem 0.36rem;
		border: 1px solid #d6e3f8;
		border-radius: 7px;
		background: #eef5ff;
		color: var(--blue-dark);
		font-size: 0.92em;
		font-weight: 720;
	}

	.post-body :global(.code-frame) {
		position: relative;
		margin: 1.45rem 0 1.8rem;
		overflow: hidden;
		border: 1px solid #26324a;
		border-radius: 18px;
		background: #0f1728;
		box-shadow: 0 18px 45px rgba(15, 23, 40, 0.18);
	}

	.post-body :global(pre) {
		margin: 0;
		padding: 3.6rem 1.15rem 1.2rem;
		overflow-x: auto;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 46px), #0f1728;
		color: #dce7ff;
		font-size: 0.92rem;
		line-height: 1.65;
		tab-size: 2;
	}

	.post-body :global(pre code) {
		display: block;
		min-width: max-content;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
		font-size: inherit;
		font-weight: 500;
	}

	.post-body :global(.copy-code) {
		position: absolute;
		top: 0.78rem;
		right: 0.78rem;
		z-index: 2;
		padding: 0.42rem 0.72rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		color: #f5f8ff;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 820;
		cursor: pointer;
		backdrop-filter: blur(8px);
		transition:
			background 0.18s ease,
			transform 0.18s ease;
	}

	.post-body :global(.copy-code:hover) {
		background: rgba(255, 255, 255, 0.18);
		transform: translateY(-1px);
	}

	.post-body :global(table) {
		display: block;
		width: 100%;
		margin: 1.6rem 0;
		overflow-x: auto;
		border-collapse: collapse;
	}

	.post-body :global(th),
	.post-body :global(td) {
		padding: 0.72rem 0.9rem;
		border: 1px solid var(--line);
		text-align: left;
	}

	.post-body :global(th) {
		background: #f2f6fb;
		color: var(--ink);
	}

	@media (max-width: 700px) {
		.blog-post {
			margin-top: 2.5rem;
		}

		.post-hero h1 {
			font-size: clamp(2.35rem, 13vw, 3.65rem);
		}

		.post-body {
			padding: 1rem;
			border-radius: 20px;
		}

		.post-body :global(pre) {
			padding: 3.35rem 0.95rem 1rem;
			font-size: 0.84rem;
		}
	}
</style>
