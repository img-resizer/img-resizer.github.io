---
import { defaultLocale, getDictionary, localizedPath, type Locale } from '../../shared/i18n';

interface Props {
	locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const dictionary = getDictionary(locale);
const path = (target: string) => localizedPath(locale, target);
---

<footer>
	<div class="footer-main">
		<a class="brand" href={path('/')}>
			<img src="/icon-cropped.png" alt="" width="38" height="38" />
			<span>Image Resizer</span>
		</a>
		<p>{dictionary.footer.copy}</p>
	</div>
	<div class="footer-links">
		<nav aria-label="Image tools">
			<strong>{dictionary.footer.tools}</strong>
			<a href={path('/')}>{dictionary.footer.resizer}</a>
			<a href={path('/tool/batch-resize/')}>{dictionary.footer.batch}</a>
			<a href={path('/compress-image/')}>{dictionary.footer.compress}</a>
			<a href={path('/image-breakpoint-generator/')}>{dictionary.footer.breakpoints}</a>
			<a href={path('/plugins/')}>{dictionary.footer.plugins}</a>
		</nav>
		<nav aria-label="Information">
			<strong>{dictionary.footer.info}</strong>
			<a href="/blog/">{dictionary.footer.guides}</a>
			<a href={path('/contact/')}>{dictionary.footer.contact}</a>
			<a href={path('/privacy-policy/')}>{dictionary.footer.privacy}</a>
			<a href={path('/terms-of-use/')}>{dictionary.footer.terms}</a>
		</nav>
	</div>
	<p class="note">{dictionary.footer.note}</p>
</footer>

<style>
	footer{display:grid;grid-template-columns:1fr auto;gap:2rem;width:min(var(--max-width),calc(100% - 2rem));margin:var(--space-7) auto 0;padding:2.5rem 0 3.5rem;border-top:1px solid var(--line);color:var(--ink-soft);font-size:.88rem}.footer-main p{max-width:360px;margin-top:.65rem}.footer-main img{width:32px;height:32px}.footer-main .brand{font-size:.95rem}.footer-links{display:flex;gap:3.5rem}.footer-links nav{display:grid;align-content:start;gap:.35rem}.footer-links strong{margin-bottom:.25rem;color:var(--ink);font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.footer-links a{color:var(--ink-soft);font-weight:650;text-decoration:none}.footer-links a:hover{color:var(--blue)}.note{grid-column:1/-1;padding-top:1.25rem;border-top:1px solid var(--line);font-size:.76rem}@media(max-width:700px){footer{grid-template-columns:1fr}.footer-links{gap:2rem;flex-wrap:wrap}}
</style>
