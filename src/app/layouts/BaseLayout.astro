---
import '../styles/global.css';
import Footer from '../../widgets/footer/Footer.astro';
import {
	defaultLocale,
	getDictionary,
	getLocaleFromPath,
	localeDir,
	localeLabels,
	locales,
	localizedPath,
	stripLocaleFromPath,
	type Locale,
} from '../../shared/i18n';
interface Props {
	title?: string;
	description?: string;
	image?: string;
	pageClass?: string;
	noindex?: boolean;
	locale?: Locale;
}
const {
	title = 'Image Resizer and Compressor',
	description = 'Resize and compress images online in your browser. Preview the result, control dimensions and file size, then download without uploading your image.',
	image = '/icon-cropped.png',
	pageClass = '',
	noindex = false,
	locale = getLocaleFromPath(Astro.url.pathname),
} = Astro.props;
const dictionary = getDictionary(locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const social = new URL(image, Astro.site ?? Astro.url);
const cleanPath = stripLocaleFromPath(Astro.url.pathname);
const isEnglishOnlyBlog =
	cleanPath === '/blog' || cleanPath === '/blog/' || cleanPath.startsWith('/blog/');
const alternateLocales = isEnglishOnlyBlog ? [defaultLocale] : locales;
const path = (target: string) => localizedPath(locale, target);
---

<!doctype html>
<html lang={locale} dir={localeDir[locale]}>
	<head>
		<meta charset='utf-8' /><meta
			name='viewport'
			content='width=device-width, initial-scale=1'
		/>
		<meta
			name='description'
			content={description}
		/>{
			noindex && (
				<meta
					name='robots'
					content='noindex,follow'
				/>
			)
		}
		<link
			rel='canonical'
			href={canonical}
		/>{
			alternateLocales.map((item) => (
				<link
					rel='alternate'
					hreflang={item}
					href={new URL(localizedPath(item, cleanPath), Astro.site ?? Astro.url)}
				/>
			))
		}<link
			rel='alternate'
			hreflang='x-default'
			href={new URL(localizedPath(defaultLocale, cleanPath), Astro.site ?? Astro.url)}
		/><link
			rel='icon'
			type='image/png'
			href='/icon-cropped.png'
		/><meta
			name='theme-color'
			content='#f7f5f0'
		/>
		<meta
			property='og:title'
			content={title}
		/><meta
			property='og:description'
			content={description}
		/><meta
			property='og:type'
			content='website'
		/><meta
			property='og:url'
			content={canonical}
		/><meta
			property='og:image'
			content={social}
		/>
		<meta
			name='twitter:card'
			content='summary'
		/><meta
			name='twitter:title'
			content={title}
		/><meta
			name='twitter:description'
			content={description}
		/><title>{title}</title>
	</head>
	<body class={pageClass}>
		<a
			class='skip-link'
			href='#main'
			>Skip to content</a
		>
		<header class='site-header'>
			<a
				class='brand'
				href={path('/')}
				><img
					src='/icon-cropped.png'
					alt=''
					width='38'
					height='38'
				/><span>Image Resizer</span></a
			>
			<nav
				class='nav'
				aria-label='Main navigation'
				><a href={path('/tool/batch-resize/')}>{dictionary.nav.batch}</a><a href={path('/compress-image/')}>{dictionary.nav.compress}</a
				><a href={path('/image-breakpoint-generator/')}>{dictionary.nav.breakpoints}</a
				><a href='/blog/'>{dictionary.nav.guides}</a>{
					isEnglishOnlyBlog && <a href='/blog/rss.xml'>{dictionary.nav.rss}</a>
				}{
					!isEnglishOnlyBlog && (
						<details class='language-switcher'><summary>{localeLabels[locale]}</summary><div>{
							locales.map((item) => (
								<a
									href={localizedPath(item, cleanPath)}
									aria-current={item === locale ? 'page' : undefined}
								>
									{localeLabels[item]}
								</a>
							))
						}</div></details>
					)
				}</nav
			>
		</header>
		<main id='main'><slot /></main><Footer locale={locale} />
	</body>
</html>
